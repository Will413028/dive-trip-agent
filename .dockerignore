!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.ts
!tsconfig.json
!next-env.d.ts
!src/
!data/
!tests/support/next-command.ts
!tests/support/next-environment.ts
!backend/pyproject.toml
!backend/uv.lock
!backend/src/
!migrations/
**/__pycache__
**/.env*
